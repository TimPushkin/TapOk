    <!-- Tutorial: intro -->
    <string name="tutorial_intro_headline">Welcome!</string>
    <string name="tutorial_intro_body_1">TapOk lets you automate taps and other actions in Android apps.</string>
    <string name="tutorial_intro_body_2">Follow this quick tutorial to learn how to set up your first automation.</string>
    <!-- Tutorial: step 1 -->
    <string name="tutorial_step1_headline">Step 1: enable the TapOk service</string>
    <string name="tutorial_step1_body_1">TapOk requires a background service to scan the screen and run your automations.</string>
    <string name="tutorial_step1_body_2_1">Open Accessibility settings</string>
    <string name="tutorial_step1_body_2_2">, find TapOk (it may be under \"Installed apps\" or \"Downloaded services\") and switch it on.</string>
    <string name="tutorial_step1_body_3">Once enabled, a floating button will appear on your screen. You\'ll use it in the next step.</string>
    <!-- Tutorial: step 2 -->
    <string name="tutorial_step2_headline">Step 2: inspect the target app</string>
    <string name="tutorial_step2_body_1">To write an automation you need to know what screen elements TapOk can interact with. A screen scanner is provided to help with that.</string>
    <string name="tutorial_step2_body_2_1">"Open the app you want to automate, then tap "</string>
    <string name="tutorial_step2_body_2_2">" on TapOk's floating button to capture a scan of the active window."</string>
    <!-- Tutorial: step 3 -->
    <string name="tutorial_step3_headline">Step 3: find a target</string>
    <string name="tutorial_step3_body_1_1">"Tap "</string>
    <string name="tutorial_step3_body_1_2">, then \"View scans\" on the floating button and open your recent scan.</string>
    <string name="tutorial_step3_body_2">Elements that TapOk can interact with will be highlighted. Tap the element you want to automate, such as a button, to view its data.</string>
    <string name="tutorial_step3_body_3">Look for a property that uniquely identifies it. View ID is the most reliable, but if it\'s empty, you can use a combination of package name and text or any other listed property that sets the element apart. Copy or save these values for the next step.</string>
    <!-- Tutorial: step 4 -->
    <string name="tutorial_step4_headline">Step 4: write a rule</string>
    <string name="tutorial_step4_body_1">Switch to the Rules tab and create a new rule.</string>
    <string name="tutorial_step4_body_2">Fill in the values you got on the previous step, choose an action and save the rule.</string>
    <string name="tutorial_step4_body_3">That\'s it! TapOk will now automatically trigger that action whenever it sees an element matching your description.</string>
    <!-- Accessibility API usage disclosure -->
    <string name="accessibility_api_usage">Accessibility API usage</string>
    <string name="accessibility_api_usage_disclosure_body_1">To automate your actions, TapOk uses the Accessibility API:</string>
    <string name="accessibility_api_usage_disclosure_body_2">analyzes the active window\'s contents and identifies targetable elements</string>
    <string name="accessibility_api_usage_disclosure_body_3">performs clicks and gestures on your behalf according to rules you specify</string>
    <string name="accessibility_api_usage_disclosure_body_4">The data is processed within TapOk, locally on your device. It is not transmitted to external servers or third parties.</string>

